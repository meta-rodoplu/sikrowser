<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    
    <!-- Application Branding & Windows Metadata -->
    <AssemblyName>Sikrowser</AssemblyName>
    <RootNamespace>Sikrowser</RootNamespace>
    <ApplicationTitle>Sikrowser</ApplicationTitle>
    <ApplicationIcon>assets\sikrowser.ico</ApplicationIcon>
    <AssemblyTitle>Sikrowser</AssemblyTitle>
    <Product>Sikrowser Ultra-Light Browser</Product>
    <Company>Sikrowser</Company>
    <Description>Windows için Ultra Hafif, Minimalist ve Düşük RAM Tüketen Web Tarayıcısı</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Sikrowser Contributors. Licensed under Mozilla Public License 2.0 (MPL-2.0).</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <None Update="filters\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
